# Copy to backend/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
# Optional: claude-haiku-4-5 is the default
ANTHROPIC_MODEL=
# auto (default) | anthropic | ollama | none
ASSISTANT_PROVIDER=auto
# Local model (no key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60
# Demo database location (default database/benefits.db; in prod use a persistent volume path)
# BENEFITS_DB_PATH=
# Assistant chat needs a signed-in session. Set to 1 only for local experiments without sign-in.
ASSISTANT_ALLOW_ANONYMOUS=0
# Sign-in token lifetime in hours, and an optional fixed signing secret (otherwise saved to database/.session_secret).
SESSION_TTL_HOURS=12
# SESSION_SECRET=

# Rate limits (in-memory, per household; sign-in creation per client IP). Over the limit: HTTP 429 + Retry-After.
RATE_LIMIT_ENABLED=1
RATE_LOGIN_PER_MINUTE=10
RATE_LOGIN_PER_HOUR=60
RATE_CHAT_PER_MINUTE=12
RATE_CHAT_PER_DAY=200
# Total chat messages for everyone per day (protects the Anthropic key)
CHAT_GLOBAL_DAILY_CAP=3000
RATE_ATTACH_PER_MINUTE=5
# /simulate, /schedule, /estimate, /annual-cost, visits
RATE_COMPUTE_PER_MINUTE=60
RATE_RESET_PER_MINUTE=5
# Set to 1 ONLY when every request really comes through your own proxy. Then the client address is
# X-Nf-Client-Connection-Ip (Netlify) if present, else the LAST X-Forwarded-For hop (never the first:
# callers can forge it). Off: the socket address is used and headers are ignored.
TRUST_PROXY=0
# Limits that do not trust any header (a caller can reach the backend port directly):
# new demo families across everyone, per minute and per hour (over the limit: 429 + Retry-After)
DEMO_GLOBAL_LOGIN_PER_MINUTE=60
DEMO_GLOBAL_LOGIN_PER_HOUR=600
# Chat messages per client address (also counted on the socket address), on top of the per-family limit
RATE_CHAT_PER_IP_PER_MINUTE=20
RATE_CHAT_PER_IP_PER_DAY=300
# Unknown or expired demo family ids one address may try per minute (stops guessing); over: 429
RATE_PROBE_PER_MINUTE=10
# How long an uploaded chat document stays in memory (minutes). At most 3 per family and 50 in total.
ATTACHMENT_TTL_MINUTES=30

# Notification bell: appointments and reminders up to this many days ahead get a notification (default 45)
# NOTIFY_WINDOW_DAYS=45

# Real notification delivery (optional). With none of these set, the app only writes "preview" rows
# and sends nothing. Set a provider's keys to turn that channel on. SMS is intentionally not wired.
# Email via Resend: an API key and a verified "from" address (e.g. "Dental <noreply@yourdomain.com>")
# RESEND_API_KEY=
# RESEND_FROM=
# Web push via VAPID: generate a keypair once (see docs/NOTIFICATIONS.md). SUBJECT is a mailto: or https: contact.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Demo sandboxes: each visitor gets a private copy of the demo family
DEMO_SANDBOX_TTL_HOURS=24
DEMO_MAX_SANDBOXES=300

# Browsers allowed to call the API (comma separated). Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=
# Optional regex for tunnel addresses, for example https://.*\.trycloudflare\.com  (see docs/DEMO-PHONES.md)
# CORS_ORIGIN_REGEX=
